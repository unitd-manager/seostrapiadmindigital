{
  "kind": "collectionType",
  "collectionName": "pages",
  "info": {
    "displayName": "Page",
    "singularName": "page",
    "pluralName": "pages"
  },
  "attributes": {
    "title": {
      "type": "string",
      "pluginOptions": {
        "content-manager": {
          "visible": false
        }
      }
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "pluginOptions": {
        "content-manager": {
          "visible": false
        }
      }
    },
    "pageType": {
      "type": "enumeration",
      "enum": [
        "landing",
        "blog",
        "about",
        "service",
        "career",
        "resource"
      ],
      "default": "landing",
      "pluginOptions": {
        "content-manager": {
          "visible": false
        }
      }
    },
    "pageBuilder": {
      "type": "dynamiczone",
      "configurable": false,
      "components": [
        "acf-sections.banner-layout",
        "acf-sections.industry-highlight-block",
        "acf-sections.industry-ai-use-cases",
        "acf-sections.common-heading-section",
        "acf-sections.unmapped-layout",
        "acf-sections.grid-layout",
        "acf-sections.home-testimonial-highlight",
        "acf-sections.home-automation-edge",
        "acf-sections.home-key-highlights",
        "acf-sections.home-featured-case-study",
        "acf-sections.footer-common-cta",
        "acf-sections.home-award-winner",
        "acf-sections.contact-form",
        "acf-sections.session-item-sections",
        "acf-sections.seo-audit-form"
      ]
    }
  }
}